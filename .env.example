# ==============================================================================
# Variables de entorno - Bot de Registro Financiero (WhatsApp Expense Bot)
# ------------------------------------------------------------------------------
# Copiá este archivo a `.env` y completá los valores marcados con <...>.
#   cp .env.example .env
# El `.env` está ignorado por git: nunca subas credenciales reales.
# Todas las variables se leen con Pydantic Settings (src/core/config.py).
# ==============================================================================

# ------------------------------------------------------------------------------
# Aplicación
# ------------------------------------------------------------------------------
APP_NAME=WhatsApp Expense Tracker
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
PORT=8000
TIMEZONE=America/Argentina/Buenos_Aires

# ------------------------------------------------------------------------------
# Groq (LLM para extracción/onboarding y Whisper para audios) - OBLIGATORIO
# API key: https://console.groq.com/keys
# ------------------------------------------------------------------------------
GROQ_API_KEY=<tu-groq-api-key>
GROQ_LLM_MODEL=openai/gpt-oss-20b
GROQ_WHISPER_MODEL=whisper-large-v3

# ------------------------------------------------------------------------------
# Evolution API (gateway de WhatsApp) - OBLIGATORIO
# En local: http://localhost:8080. Si el bot corre en Docker y Evolution en tu
# máquina: http://host.docker.internal:8080.
# EVOLUTION_API_KEY es la AUTHENTICATION_API_KEY (global o de la instancia).
# EVOLUTION_WEBHOOK_SECRET: clave larga aleatoria que Evolution envía en el
# header `x-webhook-secret`; sin ella el bot rechaza todos los webhooks.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# ------------------------------------------------------------------------------
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=<authentication-api-key-de-evolution>
EVOLUTION_INSTANCE=bot-wpp
EVOLUTION_WEBHOOK_SECRET=<clave-larga-aleatoria>

# ------------------------------------------------------------------------------
# Google Sheets (almacenamiento MVP) - OBLIGATORIO
# SPREADSHEET_ID acepta el ID o la URL completa del spreadsheet.
# Credenciales de la cuenta de servicio: o el JSON en
# config/credentials/ (se detecta solo) o una de estas dos variables.
# ------------------------------------------------------------------------------
SPREADSHEET_ID=<id-o-url-del-spreadsheet>
WORKSHEET_NAME=raw_expenses
USERS_WORKSHEET_NAME=usuarios
USER_CACHE_TTL_SECONDS=60
GOOGLE_APPLICATION_CREDENTIALS=
GCP_SERVICE_ACCOUNT_B64=

# ------------------------------------------------------------------------------
# Aprobaciones en tiempo real desde la hoja (Apps Script) - OPCIONAL
# Sin SHEETS_WEBHOOK_SECRET, /api/v1/webhooks/sheets rechaza todo.
# ------------------------------------------------------------------------------
SHEETS_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# Reportes por demanda - OPCIONAL
# REPORTS_FOLDER_ID: carpeta de Drive (compartida con los administradores)
# donde se crean los reportes; si falta, quedan en el Drive de la cuenta
# de servicio. REPORT_COOLDOWN_SECONDS: mínimo entre dos reportes por usuario.
# ------------------------------------------------------------------------------
REPORTS_FOLDER_ID=
REPORT_COOLDOWN_SECONDS=300

# ------------------------------------------------------------------------------
# Robustez y gastos múltiples - OPCIONAL
# GROQ_TIMEOUT_SECONDS: máximo que el bot espera al LLM (el SDK usa 600 s por
#   defecto, que dejaría al usuario sin respuesta ante una caída).
# GROQ_MAX_RETRIES: reintentos del SDK ante 429/5xx.
# STORAGE_TIMEOUT_SECONDS: máximo de una llamada a la base (Sheets/Postgres).
# HTTP_TIMEOUT_SECONDS: máximo de las llamadas a Evolution API (los audios usan
#   el doble).
# MAX_TRANSACTIONS_PER_MESSAGE: gastos que puede describir un solo mensaje.
# PENDING_SELECTION_TTL_SECONDS: validez de la lista numerada cuando el bot
#   pregunta cuál gasto de un lote corregir.
# ------------------------------------------------------------------------------
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=2
STORAGE_TIMEOUT_SECONDS=20
HTTP_TIMEOUT_SECONDS=15
MAX_TRANSACTIONS_PER_MESSAGE=10
PENDING_SELECTION_TTL_SECONDS=600

# ------------------------------------------------------------------------------
# Backend de almacenamiento: "sheets" (MVP, por defecto) | "postgres" (Fase 2)
# POSTGRES_* solo se usa con STORAGE_BACKEND=postgres. Con docker compose, el
# host del servicio es `postgres` (el compose ya lo define).
# ------------------------------------------------------------------------------
STORAGE_BACKEND=sheets
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=analytics_db
POSTGRES_USER=data_engineer
POSTGRES_PASSWORD=<password-de-postgres>
